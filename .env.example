NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=

# Canonical site origin (e.g. https://storyofastock.in). Set in Vercel once the
# domain exists; leave empty locally (falls back to the production URL / localhost).
NEXT_PUBLIC_SITE_URL=

# Google Search Console verification token (the value from the "HTML tag" method,
# not the whole <meta> tag). Public by design. Set per-property in Vercel.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# PostHog project API key (phc_...). Public by design (ships in the bundle).
# From PostHog → Settings → Project → Project API key. Set in Vercel too.
# Empty = PostHog stays off (instrumentation-client.ts guards on it).
NEXT_PUBLIC_POSTHOG_KEY=

# Telegram community invite link (https://t.me/+... or https://t.me/<handle>).
# Public by design. Empty = no join link renders anywhere (footer, Journal).
# Rotate here when Telegram regenerates the invite; no code change needed.
NEXT_PUBLIC_TELEGRAM_URL=

# Telegram bot for posting section updates into the group (scripts/telegram-send.mjs).
# Server-side only — never NEXT_PUBLIC_. Token from @BotFather; chat id is the
# group's numeric id (-100...), read via getUpdates after adding the bot as admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Forum topic id of the "Updates" topic (printed by concallyser/scripts/telegram_create_group.py).
TELEGRAM_UPDATES_THREAD_ID=

# Admin panel
ADMIN_PANEL_PASSCODE=
SUPABASE_SERVICE_ROLE_KEY=
